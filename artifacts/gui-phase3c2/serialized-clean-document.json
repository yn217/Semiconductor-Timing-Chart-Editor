    },
    {
      "id": "ready",
      "name": "ready",
      "type": "binary",
      "role": "output",
      "values": [
        {
          "start": 0,
          "value": 0
        },
        {
          "start": 8,
          "value": 1
        },
        {
          "start": 9,
          "value": 0
        }
      ]
    },
    {
      "id": "rdata[15:0]",
      "name": "rdata[15:0]",
      "type": "bus",
      "role": "output",
      "width": 16,
      "displayFormat": "hex",
      "values": [
        {
          "start": 0,
          "value": "XXXX"
        },
        {
          "start": 3,
          "value": "0000"
        },
        {
          "start": 6,
          "value": "5678"
        },
        {
          "start": 8,
          "value": "ABCD"
        }
      ]
    },
    {
      "id": "comment_03",
      "type": "commentRow",
      "title": "Read latency",
