{
  "formatVersion": 1,
  "document": {
    "id": "example.tcd",
    "title": "Timing Chart"
  },
  "timeline": {
    "start": 0,
    "end": 10,
    "timeBase": "cycle",
    "cycleCount": 10,
    "referenceClock": "clk",
    "edge": "falling"
  },
  "signalGroups": [
    {
      "id": "group_input",
      "name": "入力 (Input)",
      "rows": [
        "clk",
        "req_valid",
        "req_addr[7:0]",
        "comment_01"
      ]
    },
    {
      "id": "group_internal",
      "name": "内部制御 (Internal Control)",
      "rows": [
        "busy",
        "state[1:0]",
        "comment_02"
      ]
    },
    {
      "id": "group_output",
      "name": "出力 (Output)",
      "rows": [
        "ready",
        "rdata[15:0]",
        "comment_03"
      ]
    }
  ],
  "signals": [
    {
      "id": "clk",
      "name": "clk",
      "type": "clock",
      "role": "input",
      "generator": {
        "start": 0,
        "period": 1,
        "duty": 0.5,
        "phase": 0,
        "initial": 0,
        "polarity": "positive"
      },
      "edgeCounter": {
        "show": true,
        "mode": "both",
        "startNumber": 1,
        "countFrom": "signal-start",
        "labelEvery": 1,
        "position": "above",
        "offset": {
          "x": 0,
          "y": -6
        }
      }
    },
    {
      "id": "req_valid",
      "name": "req_valid",
      "type": "binary",
      "role": "input",
      "values": [
        {
          "start": 0,
          "value": 0,
          "comment": "初期値"
        },
        {
          "start": 3,
          "value": 1,
          "comment": "リクエスト有効"
        },
        {
          "start": 4,
          "value": 1,
          "comment": "リクエスト有効"
        },
        {
          "start": 7,
          "value": 0,
          "comment": "リクエスト無効（終了）"
        }
      ]
    },
    {
      "id": "req_addr[7:0]",
      "name": "req_addr[7:0]",
      "type": "bus",
      "role": "input",
      "width": 8,
