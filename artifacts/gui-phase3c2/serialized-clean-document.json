      "values": [
        {
          "start": 0,
          "value": "00",
          "comment": "初期値"
        },
        {
          "start": 2,
          "value": "12",
          "comment": "アドレス1"
        },
        {
          "start": 4,
          "value": "34",
          "comment": "アドレス2"
        },
        {
          "start": 7,
          "value": "9A",
          "comment": "最終値"
        }
      ]
