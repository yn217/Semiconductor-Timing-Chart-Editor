    },
    {
      "id": "busy",
      "name": "busy",
      "type": "binary",
      "role": "internal",
      "values": [
        {
          "start": 0,
          "value": 0
        },
        {
          "start": 2,
          "value": 1
        },
        {
          "start": 8,
          "value": 0
        }
      ]
    },
    {
      "id": "state[1:0]",
