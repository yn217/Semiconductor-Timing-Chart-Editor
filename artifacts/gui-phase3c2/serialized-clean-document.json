      "type": "state",
      "role": "internal",
      "values": [
        {
          "start": 0,
          "value": "IDLE",
          "comment": "初期状態"
        },
        {
          "start": 2,
          "value": "REQ",
          "comment": "リクエスト受付"
        },
        {
          "start": 4,
          "value": "WAIT",
          "comment": "応答待ち"
        },
        {
          "start": 6,
          "value": "EXEC",
          "comment": "実行中"
        },
        {
          "start": 8,
          "value": "DONE",
          "comment": "完了"
        },
        {
          "start": 9,
          "value": "IDLE",
          "comment": "待機へ復帰"
        }
      ]
    },
    {
      "id": "comment_02",
      "type": "commentRow",
