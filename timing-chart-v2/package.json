{
  "name": "@timing-chart-v2/workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm --workspace @timing-chart-v2/editor run dev",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:runtime-owner-types": "node scripts/check-runtime-owner-types.mjs",
    "check:interactive-controls": "node scripts/check-interactive-controls.mjs",
    "check:legacy-css-budget": "node scripts/check-legacy-css-budget.mjs",
    "check:editor-complexity": "node scripts/check-editor-complexity.mjs",
    "check:composition-root": "node scripts/check-editor-complexity.mjs",
    "check:production-presentation": "node scripts/check-production-presentation-equivalence.mjs",
    "check:performance-architecture": "node scripts/check-performance-architecture.mjs",
    "check:cycle-scroll-owner": "node scripts/check-cycle-scroll-owner.mjs",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:inventory": "node scripts/generate-test-inventory.mjs",
    "test:fast": "npm run check:boundaries && npm run check:runtime-owner-types && npm run check:interactive-controls && npm run check:legacy-css-budget && npm run check:editor-complexity && npm run check:performance-architecture && npm run check:cycle-scroll-owner && npm run check:production-presentation && npm run check:left-tree-icons && npm run check:fix-evidence && npm run check:parity && npm run test",
    "test:e2e": "node scripts/run-playwright.mjs",
    "pretest:e2e:pr": "npm run test:inventory",
    "test:e2e:pr": "node scripts/run-test-profile.mjs pr",
    "pretest:e2e:integration": "npm run test:inventory",
    "test:e2e:integration": "node scripts/run-test-profile.mjs integration",
    "pretest:e2e:visual:contracts": "npm run test:inventory",
    "test:e2e:visual:contracts": "node scripts/run-test-profile.mjs visual",
    "pretest:e2e:performance-reviewed": "npm run test:inventory",
    "test:e2e:performance-reviewed": "node scripts/run-test-profile.mjs performance",
    "test:focused": "node scripts/run-playwright.mjs",
    "test:pr": "npm run check && npm run test:e2e:pr && npm run test:perf:real-world-pr",
    "test:integration": "npm run test:e2e:integration",
    "test:visual": "npm run test:e2e:visual:contracts && npm run visual:acceptance && npm run test:visual-regression",
    "test:performance": "npm run test:e2e:performance-reviewed && npm run test:perf:pr",
    "test:nightly": "npm run test:e2e && npm run test:perf:nightly",
    "test:all": "npm run check && npm run test:e2e && npm run test:perf:nightly",
    "visual:acceptance": "playwright test tests/e2e/gui-visual-acceptance.spec.ts",
    "test:visual-regression": "playwright test tests/e2e/visual-regression-modes.spec.ts",
    "harness:capture": "playwright test tests/e2e/gui-visual-acceptance.spec.ts",
    "harness:diff": "node scripts/check-golden-diff.mjs",
    "harness:check": "npm run check:production-presentation && node scripts/check-golden-integrity.mjs && node scripts/check-golden-provenance.mjs",
    "check:left-tree-icons": "node scripts/check-left-tree-icons.mjs",
    "check:parity": "node scripts/check-v1-v2-parity.mjs",
    "harness:verify": "node scripts/run-harness-verify.mjs",
    "ai-bridge": "node scripts/ai-bridge-server.mjs",
    "reconcile:agent-status": "node scripts/reconcile-agent-status.mjs",
    "check:fix-evidence": "node scripts/check-fix-evidence.mjs",
    "build": "npm run typecheck && npm --workspace @timing-chart-v2/editor run build",
    "check": "npm run check:boundaries && npm run check:runtime-owner-types && npm run check:interactive-controls && npm run check:legacy-css-budget && npm run check:editor-complexity && npm run check:composition-root && npm run check:performance-architecture && npm run check:production-presentation && npm run check:left-tree-icons && npm run check:fix-evidence && npm run check:parity && npm run test && npm run build",
    "test:perf:pr": "playwright test tests/e2e/performance-closure.spec.ts --grep-invert nightly/manual",
    "test:perf:fixed-full-span": "node scripts/run-playwright.mjs --config=playwright.performance.config.ts tests/performance/fixed-full-span-open.spec.ts --workers=1 --trace=off",
    "test:perf:real-world-pr": "node scripts/run-playwright.mjs --config=playwright.performance.config.ts tests/performance/current-performance-samples-open.spec.ts --grep \"perf_100x500_full_span|perf_1000x1000_virtualized\" --workers=1 --trace=off",
    "test:perf:open-closure-prod": "npm --workspace @timing-chart-v2/editor run build && playwright test --config=playwright.prod-closure.config.ts --workers=1",
    "test:perf:real-world-showcases": "node scripts/run-playwright.mjs --config=playwright.performance.config.ts tests/performance/current-performance-samples-open.spec.ts --workers=1 --trace=off",
    "test:perf:nightly": "node scripts/run-performance-nightly.mjs",
    "check:ci": "npm run check && npm run check:parity && npm run test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "@vitejs/plugin-react": "5.0.2",
    "typescript": "5.9.2",
    "vite": "7.3.6",
    "vitest": "3.2.7",
    "pngjs": "^7.0.0"
  }
}
