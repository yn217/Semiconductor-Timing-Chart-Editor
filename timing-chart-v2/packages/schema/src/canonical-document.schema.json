{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yn217.example/schemas/timing-chart-v2.json",
  "title": "Semiconductor Timing Chart Editor canonical document v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "document", "timeline", "signalGroups", "signals", "bookmarks", "timeGroups", "annotations", "legend", "layout", "transactions", "constraints", "checkSettings"],
  "properties": {
    "formatVersion": { "const": 2 },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "header", "footer"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string" },
        "header": { "$ref": "#/$defs/header" },
        "footer": { "$ref": "#/$defs/footer" }
      }
    },
    "timeline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end", "timeBase", "cycleCount", "edge", "labelAnchors"],
      "properties": {
        "start": { "const": 0 },
        "end": { "type": "integer", "minimum": 1 },
        "timeBase": { "const": "cycle" },
        "cycleCount": { "type": "integer", "minimum": 1 },
        "referenceClock": { "$ref": "#/$defs/stableId" },
        "edge": { "enum": ["rising", "falling"] },
        "labelAnchors": { "type": "array", "items": { "$ref": "#/$defs/labelAnchor" } }
      }
    },
    "signalGroups": { "type": "array", "items": { "$ref": "#/$defs/group" } },
    "signals": { "type": "array", "items": { "$ref": "#/$defs/signal" } },
    "bookmarks": { "type": "array", "items": { "$ref": "#/$defs/bookmark" } },
    "timeGroups": { "type": "array", "items": { "$ref": "#/$defs/timeGroup" } },
    "annotations": { "type": "array", "items": { "$ref": "#/$defs/annotation" } },
    "legend": { "$ref": "#/$defs/legend" },
    "layout": { "$ref": "#/$defs/layout" },
    "transactions": { "type": "array", "items": { "$ref": "#/$defs/transaction" } },
    "constraints": { "type": "array", "items": { "$ref": "#/$defs/constraint" } },
    "checkSettings": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "enabledCategories": { "type": "array", "items": { "type": "string" }, "uniqueItems": true } }
    }
  },
  "$defs": {
    "stableId": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$" },
    "offset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": { "x": { "type": "number" }, "y": { "type": "number" } }
    },
    "jsonObject": { "type": "object" },
    "header": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subtitle", "description", "notes", "preconditions", "constraints", "exceptions"],
      "properties": {
        "subtitle": { "type": "string" }, "description": { "type": "string" }, "notes": { "type": "string" },
        "preconditions": { "type": "array", "items": { "type": "string" } },
        "constraints": { "type": "array", "items": { "type": "string" } },
        "exceptions": { "type": "array", "items": { "type": "string" } }
      }
    },
    "footer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["figureNumber", "revision", "text"],
      "properties": { "figureNumber": { "type": "string" }, "revision": { "type": "string" }, "text": { "type": "string" } }
    },
    "labelAnchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source", "display"],
      "properties": { "id": { "$ref": "#/$defs/stableId" }, "source": { "type": "number" }, "display": { "type": "number" }, "ownerTimeGroupId": { "$ref": "#/$defs/stableId" } }
    },
    "spacer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "height"],
      "properties": { "id": { "$ref": "#/$defs/stableId" }, "height": { "type": "number", "exclusiveMinimum": 0 } }
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "rows"],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" }, "name": { "type": "string", "minLength": 1 },
        "rows": { "type": "array", "items": { "$ref": "#/$defs/stableId" } },
        "spacers": { "type": "array", "items": { "$ref": "#/$defs/spacer" } },
        "spacingBefore": { "type": "number", "minimum": 0 }, "spacingAfter": { "type": "number", "minimum": 0 },
        "style": { "$ref": "#/$defs/groupStyle" }
      }
    },
    "groupStyle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "showBackground": { "type": "boolean" },
        "background": { "type": "string" },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
        "extend": { "enum": ["label", "waveform", "both"] },
        "border": { "type": "string" },
        "showHeader": { "type": "boolean" }
      }
    },
    "source": {
      "type": "object", "additionalProperties": false, "required": ["instancePath", "signalName"],
      "properties": { "instancePath": { "type": "array", "items": { "type": "string" } }, "signalName": { "type": "string" }, "msb": { "type": "integer" }, "lsb": { "type": "integer" } }
    },
    "display": {
      "type": "object", "additionalProperties": false, "required": ["name"],
      "properties": { "name": { "type": "string" }, "visible": { "type": "boolean" }, "style": { "$ref": "#/$defs/jsonObject" }, "align": { "enum": ["left", "center", "right"] }, "overflow": { "enum": ["expand", "ellipsis", "wrap"] } }
    },
    "change": {
      "type": "object", "additionalProperties": false, "required": ["start", "value"],
      "properties": { "start": { "type": "number", "minimum": 0 }, "value": { "type": ["string", "number"] }, "comment": { "type": "string" } }
    },
    "generator": {
      "type": "object", "additionalProperties": false, "required": ["start", "period", "duty", "phase", "initial", "polarity"],
      "properties": { "start": { "type": "number" }, "period": { "type": "number", "exclusiveMinimum": 0 }, "duty": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }, "phase": { "type": "number" }, "initial": { "enum": [0, 1] }, "polarity": { "enum": ["positive", "negative"] }, "suppressedPeriods": { "type": "array", "items": { "type": "integer", "minimum": 0 }, "uniqueItems": true } }
    },
    "edgeCounter": {
      "type": "object", "additionalProperties": false, "required": ["show", "mode", "startNumber", "countFrom", "labelEvery", "position", "offset"],
      "properties": { "show": { "type": "boolean" }, "mode": { "enum": ["rising", "falling", "both"] }, "startNumber": { "type": "integer" }, "countFrom": { "enum": ["signal-start", "selected-edge", "marker", "visible-range-start"] }, "labelEvery": { "type": "integer", "minimum": 1 }, "position": { "enum": ["above", "below"] }, "offset": { "$ref": "#/$defs/offset" }, "anchorId": { "type": "string" } }
    },
    "signal": {
      "type": "object",
      "required": ["id", "name", "type", "role", "source", "display"],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" }, "name": { "type": "string", "minLength": 1 },
        "type": { "enum": ["binary", "bus", "state", "logic", "event", "pulse", "clock", "commentRow"] },
        "role": { "enum": ["input", "output", "internal"] }, "source": { "$ref": "#/$defs/source" }, "display": { "$ref": "#/$defs/display" },
        "values": { "type": "array", "items": { "$ref": "#/$defs/change" }, "minItems": 1 },
        "generator": { "$ref": "#/$defs/generator" }, "enable": { "type": "array", "items": { "$ref": "#/$defs/change" } }, "edgeCounter": { "$ref": "#/$defs/edgeCounter" },
        "width": { "type": "integer", "minimum": 1 }, "displayFormat": { "enum": ["hex", "binary", "symbolic"] },
        "title": { "type": "string" }, "body": { "type": "string" }, "spacingBefore": { "type": "number", "minimum": 0 }, "spacingAfter": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false,
      "allOf": [
        { "if": { "properties": { "type": { "const": "clock" } }, "required": ["type"] }, "then": { "required": ["generator", "edgeCounter"], "not": { "required": ["values"] } } },
        { "if": { "properties": { "type": { "const": "commentRow" } }, "required": ["type"] }, "then": { "required": ["title", "body"], "not": { "anyOf": [{ "required": ["values"] }, { "required": ["generator"] }] } } },
        { "if": { "not": { "properties": { "type": { "enum": ["clock", "commentRow"] } }, "required": ["type"] } }, "then": { "required": ["values"] } }
      ]
    },
    "anchor": {
      "type": "object", "additionalProperties": false, "required": ["cycle", "point"],
      "properties": { "signalId": { "$ref": "#/$defs/stableId" }, "cycle": { "type": "number", "minimum": 0 }, "point": { "enum": ["cycle-start", "cycle-center", "cycle-end", "transition-start", "transition-center", "transition-end", "rising-edge", "falling-edge", "value-start"] }, "offset": { "$ref": "#/$defs/offset" } }
    },
    "annotation": {
      "type": "object", "additionalProperties": false, "required": ["id", "type", "label", "visible"],
      "properties": { "id": { "$ref": "#/$defs/stableId" }, "type": { "enum": ["text", "callout", "verticalLine", "range", "bracket", "highlight", "marker", "measurement", "arrow", "dependency"] }, "label": { "type": "string" }, "visible": { "type": "boolean" }, "color": { "type": "string" }, "comment": { "type": "string" }, "anchor": { "$ref": "#/$defs/anchor" }, "start": { "$ref": "#/$defs/anchor" }, "end": { "$ref": "#/$defs/anchor" }, "from": { "$ref": "#/$defs/anchor" }, "to": { "$ref": "#/$defs/anchor" }, "labelOffset": { "$ref": "#/$defs/offset" }, "style": { "$ref": "#/$defs/jsonObject" }, "lineType": { "enum": ["straight", "orthogonal", "curve", "diagonal"] }, "arrowhead": { "enum": ["end", "start", "bidirectional", "none"] } }
    },
    "bookmark": { "type": "object", "additionalProperties": false, "required": ["id", "name", "start"], "properties": { "id": { "$ref": "#/$defs/stableId" }, "name": { "type": "string", "minLength": 1 }, "start": { "type": "number", "minimum": 0 }, "comment": { "type": "string" } } },
    "timeGroup": { "type": "object", "additionalProperties": false, "required": ["id", "name", "start", "end"], "properties": { "id": { "$ref": "#/$defs/stableId" }, "name": { "type": "string", "minLength": 1 }, "category": { "type": "string" }, "start": { "type": "number", "minimum": 0 }, "end": { "type": "number", "exclusiveMinimum": 0 }, "comment": { "type": "string" }, "presentation": { "type": "object", "additionalProperties": false, "properties": { "collapsed": { "type": "boolean" }, "foldStyle": { "enum": ["none", "compact", "axis-break"] }, "foldLabel": { "type": "string" }, "resumeLabelAnchorId": { "$ref": "#/$defs/stableId" } } } } },
    "transaction": { "type": "object", "additionalProperties": false, "required": ["id", "name", "start", "end"], "properties": { "id": { "$ref": "#/$defs/stableId" }, "name": { "type": "string" }, "source": { "type": "string" }, "destination": { "type": "string" }, "start": { "type": "number", "minimum": 0 }, "end": { "type": "number", "exclusiveMinimum": 0 }, "phases": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["name", "start", "end"], "properties": { "name": { "type": "string" }, "start": { "type": "number", "minimum": 0 }, "end": { "type": "number", "exclusiveMinimum": 0 } } } }, "links": { "$ref": "#/$defs/jsonObject" } } },
    "constraint": { "type": "object", "additionalProperties": false, "required": ["id", "type"], "properties": { "id": { "$ref": "#/$defs/stableId" }, "type": { "type": "string", "minLength": 1 }, "data": { "$ref": "#/$defs/jsonObject" } } },
    "legend": { "type": "object", "additionalProperties": false, "required": ["show", "orientation", "usedRolesOnly", "position"], "properties": { "show": { "type": "boolean" }, "orientation": { "enum": ["horizontal", "vertical"] }, "usedRolesOnly": { "type": "boolean" }, "position": { "$ref": "#/$defs/offset" }, "style": { "$ref": "#/$defs/jsonObject" } } },
    "layout": { "type": "object", "additionalProperties": false, "required": ["roleColumnWidth", "signalNameWidth", "signalNameAlign", "rowHeight", "signalSpacing", "overflow"], "properties": { "roleColumnWidth": { "type": "number", "minimum": 0 }, "signalNameWidth": { "type": "number", "exclusiveMinimum": 0 }, "signalNameAlign": { "enum": ["left", "center", "right"] }, "rowHeight": { "type": "number", "exclusiveMinimum": 0 }, "signalSpacing": { "type": "number", "minimum": 0 }, "overflow": { "enum": ["expand", "ellipsis", "wrap"] } } }
  }
}
