{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yn217.example/schemas/timing-chart-v2.json",
  "title": "Semiconductor Timing Chart Editor canonical document v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "formatVersion",
    "document",
    "timeline",
    "signalGroups",
    "signals",
    "bookmarks",
    "timeGroups",
    "annotations",
    "annotationGroups",
    "legend",
    "layout",
    "transactions",
    "constraints",
    "checkSettings"
  ],
  "properties": {
    "formatVersion": { "const": 2 },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "header", "footer"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string" },
        "header": { "$ref": "#/$defs/header" },
        "footer": { "$ref": "#/$defs/footer" }
      }
    },
    "timeline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end",
        "timeBase",
        "cycleCount",
        "edge",
        "labelAnchors"
      ],
      "properties": {
        "start": { "const": 0 },
        "end": { "type": "integer", "minimum": 1 },
        "timeBase": { "const": "cycle" },
        "cycleCount": { "type": "integer", "minimum": 1 },
        "referenceClock": { "$ref": "#/$defs/stableId" },
        "physicalTimebase": {
          "type": "object",
          "additionalProperties": false,
          "required": ["referenceFrequencyHz", "unit"],
          "properties": {
            "referenceFrequencyHz": { "type": "number" },
            "unit": { "enum": ["s", "ms", "us", "ns", "ps", "fs"] }
          }
        },
        "edge": { "enum": ["rising", "falling"] },
        "labelAnchors": {
          "type": "array",
          "items": { "$ref": "#/$defs/labelAnchor" }
        }
      }
    },
    "signalGroups": { "type": "array", "items": { "$ref": "#/$defs/group" } },
    "signals": { "type": "array", "items": { "$ref": "#/$defs/signal" } },
    "bookmarks": { "type": "array", "items": { "$ref": "#/$defs/bookmark" } },
    "timeGroups": { "type": "array", "items": { "$ref": "#/$defs/timeGroup" } },
    "annotations": {
      "type": "array",
      "items": { "$ref": "#/$defs/annotation" }
    },
    "annotationGroups": {
      "type": "array",
      "items": { "$ref": "#/$defs/annotationGroup" }
    },
    "legend": { "$ref": "#/$defs/legend" },
    "layout": { "$ref": "#/$defs/layout" },
    "transactions": {
      "type": "array",
      "items": { "$ref": "#/$defs/transaction" }
    },
    "transactionGroups": {
      "type": "array",
      "items": { "$ref": "#/$defs/transactionGroup" }
    },
    "transactionTimeScale": { "$ref": "#/$defs/transactionTimeScale" },
    "enumDefinitions": { "type": "array", "items": { "$ref": "#/$defs/enumDefinition" } },
    "constraints": {
      "type": "array",
      "items": { "$ref": "#/$defs/constraint" }
    },
    "checkSettings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabledCategories": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        }
      }
    }
  },
  "$defs": {
    "stableId": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$" },
    "enumDefinition": { "type": "object", "additionalProperties": false, "required": ["id", "name", "entries"], "properties": { "id": { "$ref": "#/$defs/stableId" }, "name": { "type": "string", "minLength": 1 }, "entries": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["value", "label"], "properties": { "value": { "type": ["string", "number"] }, "label": { "type": "string", "minLength": 1 } } } } } },
    "resetSemantics": { "type": "object", "additionalProperties": false, "required": ["polarity", "synchronization"], "properties": { "polarity": { "enum": ["active-high", "active-low"] }, "synchronization": { "enum": ["synchronous", "asynchronous"] }, "assertCycle": { "type": "integer", "minimum": 0 }, "deassertCycle": { "type": "integer", "minimum": 0 } } },
    "offset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": { "x": { "type": "number" }, "y": { "type": "number" } }
    },
    "jsonObject": { "type": "object" },
    "header": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subtitle",
        "description",
        "notes",
        "preconditions",
        "constraints",
        "exceptions"
      ],
      "properties": {
        "subtitle": { "type": "string" },
        "description": { "type": "string" },
        "visible": { "type": "boolean" },
        "notes": { "type": "string" },
        "preconditions": { "type": "array", "items": { "type": "string" } },
        "constraints": { "type": "array", "items": { "type": "string" } },
        "exceptions": { "type": "array", "items": { "type": "string" } }
      }
    },
    "footer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["figureNumber", "revision", "text"],
      "properties": {
        "figureNumber": { "type": "string" },
        "revision": { "type": "string" },
        "text": { "type": "string" }
      }
    },
    "labelAnchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source", "display"],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "source": { "type": "number" },
        "display": { "type": "number" },
        "ownerTimeGroupId": { "$ref": "#/$defs/stableId" }
      }
    },
    "spacer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "height"],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "height": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "rows"],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "name": { "type": "string", "minLength": 1 },
        "rows": { "type": "array", "items": { "$ref": "#/$defs/stableId" } },
        "spacers": { "type": "array", "items": { "$ref": "#/$defs/spacer" } },
        "spacingBefore": { "type": "number", "minimum": 0 },
        "spacingAfter": { "type": "number", "minimum": 0 },
        "style": { "$ref": "#/$defs/groupStyle" }
      }
    },
    "annotationGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "annotationIds"],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "name": { "type": "string", "minLength": 1 },
        "annotationIds": {
          "type": "array",
          "items": { "$ref": "#/$defs/stableId" }
        }
      }
    },
    "groupStyle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "showBackground": { "type": "boolean" },
        "background": { "type": "string" },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
        "extend": { "enum": ["label", "waveform", "both"] },
        "border": { "type": "string" },
        "showHeader": { "type": "boolean" },
        "headerHeight": { "type": "number", "minimum": 0 }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instancePath", "signalName"],
      "properties": {
        "instancePath": { "type": "array", "items": { "type": "string" } },
        "signalName": { "type": "string" },
        "msb": { "type": "integer" },
        "lsb": { "type": "integer" }
      }
    },
    "display": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "visible": { "type": "boolean" },
        "style": { "$ref": "#/$defs/jsonObject" },
        "align": { "enum": ["left", "center", "right"] },
        "overflow": { "enum": ["expand", "ellipsis", "wrap"] }
      }
    },
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "value"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "start": { "type": "number", "minimum": 0 },
        "value": { "type": ["string", "number"] },
        "displayLabel": { "type": "string" },
        "comment": { "type": "string" }
      }
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "period", "duty", "phase", "initial", "polarity"],
      "properties": {
        "start": { "type": "number" },
        "period": { "type": "number", "exclusiveMinimum": 0 },
        "duty": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "phase": { "type": "number" },
        "initial": { "enum": [0, 1] },
        "polarity": { "enum": ["positive", "negative"] },
        "suppressedPeriods": {
          "type": "array",
          "items": { "type": "integer", "minimum": 0 },
          "uniqueItems": true
        }
      }
    },
    "edgeCounter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "show",
        "mode",
        "startNumber",
        "countFrom",
        "labelEvery",
        "position",
        "offset"
      ],
      "properties": {
        "show": { "type": "boolean" },
        "mode": { "enum": ["rising", "falling", "both"] },
        "startNumber": { "type": "integer" },
        "countFrom": {
          "enum": [
            "signal-start",
            "selected-edge",
            "marker",
            "visible-range-start"
          ]
        },
        "labelEvery": { "type": "integer", "minimum": 1 },
        "position": { "enum": ["above", "below"] },
        "offset": { "$ref": "#/$defs/offset" },
        "anchorId": { "type": "string" }
      }
    },
    "signal": {
      "type": "object",
      "required": ["id", "name", "type", "role", "source", "display"],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "name": { "type": "string", "minLength": 1 },
        "type": {
          "enum": [
            "binary",
            "bus",
            "state",
            "logic",
            "event",
            "pulse",
            "clock",
            "commentRow"
          ]
        },
        "role": { "enum": ["input", "output", "internal"] },
        "source": { "$ref": "#/$defs/source" },
        "display": { "$ref": "#/$defs/display" },
        "values": {
          "type": "array",
          "items": { "$ref": "#/$defs/change" },
          "minItems": 1
        },
        "generator": { "$ref": "#/$defs/generator" },
        "enable": { "type": "array", "items": { "$ref": "#/$defs/change" } },
        "edgeCounter": { "$ref": "#/$defs/edgeCounter" },
        "width": { "type": "integer", "minimum": 1 },
        "displayFormat": { "enum": ["hex", "binary", "decimal", "signed", "unsigned", "symbolic"] },
        "enumId": { "type": "string", "minLength": 1 },
        "resetSemantics": { "$ref": "#/$defs/resetSemantics" },
        "title": { "type": "string" },
        "body": { "type": "string" },
        "spacingBefore": { "type": "number", "minimum": 0 },
        "spacingAfter": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": { "type": { "const": "clock" } },
            "required": ["type"]
          },
          "then": {
            "required": ["generator", "edgeCounter"],
            "not": {
              "anyOf": [
                { "required": ["values"] },
                { "required": ["width"] },
                { "required": ["displayFormat"] },
                { "required": ["title"] },
                { "required": ["body"] }
              ]
            }
          }
        },
        {
          "if": {
            "properties": { "type": { "const": "commentRow" } },
            "required": ["type"]
          },
          "then": {
            "required": ["title", "body"],
            "properties": { "role": { "const": "internal" } },
            "not": {
              "anyOf": [
                { "required": ["values"] },
                { "required": ["generator"] },
                { "required": ["enable"] },
                { "required": ["edgeCounter"] },
                { "required": ["width"] },
                { "required": ["displayFormat"] }
              ]
            }
          }
        },
        {
          "if": {
            "properties": { "type": { "const": "bus" } },
            "required": ["type"]
          },
          "then": {
            "required": ["values"],
            "not": {
              "anyOf": [
                { "required": ["generator"] },
                { "required": ["enable"] },
                { "required": ["edgeCounter"] },
                { "required": ["title"] },
                { "required": ["body"] }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": { "enum": ["binary", "state", "logic", "event", "pulse"] }
            },
            "required": ["type"]
          },
          "then": {
            "required": ["values"],
            "not": {
              "anyOf": [
                { "required": ["generator"] },
                { "required": ["enable"] },
                { "required": ["edgeCounter"] },
                { "required": ["width"] },
                { "required": ["displayFormat"] },
                { "required": ["title"] },
                { "required": ["body"] }
              ]
            }
          }
        }
      ]
    },
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cycle", "point"],
      "properties": {
        "signalId": { "$ref": "#/$defs/stableId" },
        "cycle": { "type": "number", "minimum": 0 },
        "point": {
          "enum": [
            "cycle-start",
            "cycle-center",
            "cycle-end",
            "transition-start",
            "transition-center",
            "transition-end",
            "rising-edge",
            "falling-edge",
            "value-start",
            "value-center",
            "row-center"
          ]
        },
        "threshold": { "type": "number", "minimum": 0, "maximum": 1 },
        "transition": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": {
            "kind": { "enum": ["threshold", "ratio"] },
            "value": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        },
        "offset": { "$ref": "#/$defs/offset" }
      }
    },
    "annotation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "label", "visible"],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "type": {
          "enum": [
            "text",
            "callout",
            "verticalLine",
            "range",
            "bracket",
            "highlight",
            "marker",
            "measurement",
            "arrow",
            "dependency",
            "timingRegion",
            "ghostTrace",
            "rectangle",
            "ellipse",
            "connector",
            "textbox"
          ]
        },
        "label": { "type": "string" },
        "visible": { "type": "boolean" },
        "color": { "type": "string" },
        "comment": { "type": "string" },
        "anchor": { "$ref": "#/$defs/anchor" },
        "start": { "$ref": "#/$defs/anchor" },
        "end": { "$ref": "#/$defs/anchor" },
        "from": { "$ref": "#/$defs/anchor" },
        "to": { "$ref": "#/$defs/anchor" },
        "labelOffset": { "$ref": "#/$defs/offset" },
        "labelPlacement": { "enum": ["start", "center", "end", "above", "below"] },
        "style": { "$ref": "#/$defs/jsonObject" },
        "lineType": { "enum": ["straight", "orthogonal", "curve", "diagonal"] },
        "arrowhead": { "enum": ["end", "start", "bidirectional", "none"] },
        "sourceSignalId": { "$ref": "#/$defs/stableId" },
        "traceOffsetCycles": { "type": "number" },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
        "rotation": { "type": "number" },
        "align": { "enum": ["left", "center", "right"] },
        "locked": { "type": "boolean" },
        "positionMode": { "enum": ["cycle-snap", "free"] },
        "measurement": {
          "type": "object",
          "additionalProperties": false,
          "required": ["profile", "anchorKind"],
          "properties": {
            "profile": {
              "enum": ["cycle", "30-70", "10-90", "20-80", "50%", "custom"]
            },
            "anchorKind": { "enum": ["threshold", "ratio"] }
          }
        },
        "measurementLayout": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "startMarker",
            "endMarker",
            "arrowLayout",
            "extensionLines"
          ],
          "properties": {
            "startMarker": { "enum": ["none", "bar", "arrow"] },
            "endMarker": { "enum": ["none", "bar", "arrow"] },
            "arrowLayout": { "enum": ["inward", "outward", "auto"] },
            "extensionLines": { "enum": ["none", "start", "end", "both"] },
            "lane": { "type": "integer", "minimum": 0, "maximum": 19999 }
          }
        },
        "verticalSpan": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": {
            "mode": { "enum": ["auto", "rows", "custom"] },
            "startRowId": { "$ref": "#/$defs/stableId" },
            "endRowId": { "$ref": "#/$defs/stableId" },
            "startOffset": { "type": "number" },
            "endOffset": { "type": "number" }
          }
        }
      }
    },
    "bookmark": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "start"],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "name": { "type": "string", "minLength": 1 },
        "start": { "type": "number", "minimum": 0 },
        "comment": { "type": "string" }
      }
    },
    "timeGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "start", "end"],
      "properties": {
        "parentId": { "$ref": "#/$defs/stableId" },
        "id": { "$ref": "#/$defs/stableId" },
        "name": { "type": "string", "minLength": 1 },
        "category": { "type": "string" },
        "start": { "type": "number", "minimum": 0 },
        "end": { "type": "number", "exclusiveMinimum": 0 },
        "comment": { "type": "string" },
        "presentation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "collapsed": { "type": "boolean" },
            "foldStyle": { "enum": ["none", "compact", "axis-break"] },
            "foldLabel": { "type": "string" },
            "resumeLabelAnchorId": { "$ref": "#/$defs/stableId" }
          }
        }
      }
    },
    "transaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "start", "end"],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "name": { "type": "string", "minLength": 1 },
        "source": { "type": "string" },
        "destination": { "type": "string" },
        "start": { "type": "number", "minimum": 0 },
        "end": { "type": "number", "exclusiveMinimum": 0 },
        "phases": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "start", "end"],
            "properties": {
              "name": { "type": "string" },
              "start": { "type": "number", "minimum": 0 },
              "end": { "type": "number", "exclusiveMinimum": 0 }
            }
          }
        },
        "laneId": { "type": "string", "minLength": 1 },
        "groupId": { "$ref": "#/$defs/stableId" },
        "color": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "visible": { "type": "boolean" },
        "linkedSignals": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/stableId" }
        },
        "category": { "type": "string" },
        "style": { "$ref": "#/$defs/jsonObject" },
        "metadata": { "$ref": "#/$defs/jsonObject" },
        "links": { "$ref": "#/$defs/jsonObject" }
      }
    },
    "transactionGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "order"],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "name": { "type": "string", "minLength": 1 },
        "color": { "type": "string", "minLength": 1 },
        "order": { "type": "integer", "minimum": 0 }
      }
    },
    "transactionTimeScale": {
      "type": "object", "additionalProperties": false,
      "required": ["clockCyclesPerTransactionCycle", "majorInterval", "minorInterval"],
      "properties": {
        "clockCyclesPerTransactionCycle": { "type": "integer", "minimum": 1 },
        "majorInterval": { "type": "integer", "minimum": 1 },
        "minorInterval": { "type": "integer", "minimum": 1 },
        "showSecondaryClock": { "type": "boolean" }
      }
    },
    "constraint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type"],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "type": { "type": "string", "minLength": 1 },
        "data": { "$ref": "#/$defs/jsonObject" }
      }
    },
    "legendEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role", "label", "visible", "order"],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "role": { "enum": ["input", "output", "internal"] },
        "label": { "type": "string", "minLength": 1 },
        "visible": { "type": "boolean" },
        "order": { "type": "integer", "minimum": 0 }
      }
    },
    "legend": {
      "type": "object",
      "additionalProperties": false,
      "required": ["show", "orientation", "usedRolesOnly", "position"],
      "properties": {
        "show": { "type": "boolean" },
        "orientation": { "enum": ["horizontal", "vertical"] },
        "usedRolesOnly": { "type": "boolean" },
        "position": { "$ref": "#/$defs/offset" },
        "positionMode": { "enum": ["free", "canvas-corner"] },
        "corner": { "enum": ["top-left", "top-right", "bottom-left", "bottom-right"] },
        "items": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/legendEntry" }
        },
        "style": { "$ref": "#/$defs/jsonObject" }
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "roleColumnWidth",
        "signalNameWidth",
        "signalNameAlign",
        "rowHeight",
        "signalSpacing",
        "overflow"
      ],
      "properties": {
        "roleColumnWidth": { "type": "number", "minimum": 0 },
        "signalNameWidth": { "type": "number", "exclusiveMinimum": 0 },
        "signalNameAlign": { "enum": ["left", "center", "right"] },
        "rowHeight": { "type": "number", "exclusiveMinimum": 0 },
        "signalSpacing": { "type": "number", "minimum": 0 },
        "overflow": { "enum": ["expand", "ellipsis", "wrap"] }
      }
    }
  }
}
